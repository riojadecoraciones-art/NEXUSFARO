# ============================================================
# NEXUS FARO — Variables de entorno
# ------------------------------------------------------------
# Copiá este archivo a .env.local y completá los valores.
# .env.local NUNCA debe subirse al repositorio.
# ============================================================

# --- Supabase (obligatorio) ---
# Supabase → Project Settings → API
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-key"

# --- Acceso maestro / soporte técnico (opcional) ---
# Hash PBKDF2 de la contraseña maestra. NO pongas la contraseña en texto plano.
# Para generarlo:  npm run hash-password
# Si esta variable está vacía, el modo maestro queda deshabilitado.
VITE_MASTER_PASSWORD_HASH=""

# --- Primer arranque (opcional) ---
# PIN de 4 dígitos del usuario Dueño cuando la base está vacía.
# Si se deja vacío, el sistema genera uno al azar y lo muestra una sola vez.
VITE_SEED_OWNER_PIN=""
